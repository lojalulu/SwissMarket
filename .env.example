# Copie para .env (no telemóvel E na VPS) e preencha.

# ── VPS (Next.js) ─────────────────────────────
# Token partilhado: o runner só consegue gravar dados se enviar este valor.
# Gere um com:  openssl rand -hex 24
INGEST_TOKEN=troque-por-um-token-longo
# Pasta onde fica o db.json (por omissão ./data)
# DATA_DIR=/var/lib/swissmarket
PORT=3000

# ── Alertas no telemóvel (VPS) ────────────────
# ntfy: instale a app "ntfy" (Play Store), toque em + e subscreva ESTE tópico (nome secreto, difícil de adivinhar)
# NTFY_TOPIC=swissmarket-troque-por-algo-aleatorio
# Telegram (opcional): crie um bot com @BotFather e obtenha o chat_id
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Score mínimo (0–100) e tipos de alerta
ALERT_MIN_SCORE=45
ALERT_KINDS=buynow,auction,offer
# Códigos postais "perto de casa" (retirada sem portes) — 2 primeiros dígitos
HOME_ZIPS=30,31,32,33,34,36,37,38

# ── Comprar no Tutti/Anibis (VPS) ─────────────
# Fontes lidas pelo robô (tutti, anibis)
BUY_SOURCES=tutti
# Raio máximo de carro a partir de casa (min)
MAX_DRIVE_MIN=40
# Casa e trabalho (padrão: centro de Bern → Interlaken). WORK_LAT=off desliga o "no caminho".
# HOME_LAT=46.948
# HOME_LON=7.4474
# WORK_LAT=46.6863
# WORK_LON=7.8632
# Custo do carro por km (combustível + desgaste)
TRAVEL_CHF_PER_KM=0.25
# Tempos reais de estrada via OSRM (osrm) ou só estimativa (estimate)
DRIVE_TIMES=osrm
# 1 = só alerta vendedores com perfil visível (nome + "membro desde")
BUY_REQUIRE_PROFILE=0
# 0 = sem alertas de "negociar"
BUY_ALERT_NEGOTIATE=1

# ── Runner (Termux) ───────────────────────────
API_URL=http://188.245.76.183:3000
# CHROMIUM_PATH=/data/data/com.termux/files/usr/bin/chromium-browser
# Pausa média entre páginas (ms). Não baixe de 5000: respeito ao site e menos bloqueios.
DELAY_MS=7000
# Máx. de anúncios terminados reabertos por ciclo para confirmar a venda
RECHECK_MAX=25
# Chromium novo a cada N páginas. 1 = recomendado (menos bloqueios da Cloudflare)
RESTART_BROWSER_EVERY=1
# 1 = --single-process (mais leve no Android). Mude para 0 se o Chromium crashar.
SINGLE_PROCESS=1
# Máx. de anúncios Tutti abertos por ciclo para ver o vendedor
BUY_DETAILS_MAX=8
# Só estes produtos (ids de config/products.ts), vazio = todos
# PRODUCTS=iphone-13,ps5
